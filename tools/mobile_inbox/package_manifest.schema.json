{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Segeran Jiwa POS Next Mobile Inbox Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "milestone",
    "title",
    "revision",
    "package_type",
    "blueprint_baseline",
    "target_branch",
    "base_commit",
    "schema_version_expected",
    "retry_safe",
    "files_manifest",
    "delete_paths"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^R[1-9][0-9]*$"
    },
    "package_type": {
      "enum": ["patch", "schema_patch"]
    },
    "blueprint_baseline": {
      "const": "1.0"
    },
    "target_branch": {
      "type": "string",
      "pattern": "^work/[a-z0-9][a-z0-9._/-]*$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "schema_version_expected": {
      "type": "integer",
      "minimum": 0
    },
    "retry_safe": {
      "type": "boolean"
    },
    "files_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "delete_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
